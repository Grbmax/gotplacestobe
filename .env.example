# Every one of these is optional — the app runs with none of them set,
# falling back to mock detection / in-memory storage / a lite localStorage
# identity picker. Add them as they become available; nothing needs code
# changes to pick them up.

# MongoDB Atlas — real persistence instead of in-memory (resets on restart)
MONGODB_URI=

# Gemini API — real detection instead of the deterministic mock
# Get a free key at https://ai.google.dev / Google AI Studio
GEMINI_API_KEY=

# Roboflow — CV verifier after Gemini (your trained project/version)
# API key: https://app.roboflow.com/settings/api
# Model id must be project/VERSION — e.g. building-defect-on-walls-smfwl/1
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=building-defect-on-walls-smfwl/1
# ROBOFLOW_MAX_CONCURRENT=10

# Vercel Blob — store captured images as URLs instead of inline base64
# (inline works fine, just bloats every document and every list fetch)
BLOB_READ_WRITE_TOKEN=

# Auth0 — real sign-in instead of the lite name+role picker.
# Create a "Regular Web Application" at https://manage.auth0.com, then:
#  - Allowed Callback URLs: http://localhost:3000/auth/callback
#  - Allowed Logout URLs:   http://localhost:3000
# All four of these are required together, or none of them — partial config
# is treated as "not configured" and falls back to lite mode.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
