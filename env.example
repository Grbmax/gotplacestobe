# Copy to .env.local and fill in:
#   cp .env.example .env.local

# Google AI Studio — Quest FavorChat compose + Inspect Gemini detector
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# MongoDB Atlas URI (Quest uses default DB from path; Inspect uses db name "scan")
MONGODB_URI=

# Optional: force detector (gemini | mock). Default: gemini when GEMINI_API_KEY is set.
# DETECTOR=mock

# Optional: Vercel Blob for scan image storage (otherwise data URLs are kept)
# BLOB_READ_WRITE_TOKEN=
